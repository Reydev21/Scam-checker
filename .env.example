# Copy this file to .env and replace every placeholder value.
# Never expose SUPABASE_SERVICE_ROLE_KEY in browser code or public repositories.

SCAMCHECK_SECRET_KEY=replace-with-a-long-random-secret
SCAMCHECK_PUBLIC_URL=http://127.0.0.1:5000

# Admin login
SCAMCHECK_ADMIN_EMAIL=your-admin-email@example.com
SCAMCHECK_ADMIN_PASSWORD_HASH=replace-with-sha256-password-hash

# Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP for forgot-password emails
# Use a Gmail App Password, not your normal Gmail password.
SCAMCHECK_SMTP_HOST=smtp.gmail.com
SCAMCHECK_SMTP_PORT=587
SCAMCHECK_SMTP_USER=your-gmail-address@gmail.com
SCAMCHECK_SMTP_PASSWORD=your-16-character-gmail-app-password
SCAMCHECK_SMTP_FROM=your-gmail-address@gmail.com

# Optional social login
SCAMCHECK_GOOGLE_CLIENT_ID=
SCAMCHECK_GOOGLE_CLIENT_SECRET=
SCAMCHECK_FACEBOOK_CLIENT_ID=
SCAMCHECK_FACEBOOK_CLIENT_SECRET=
SCAMCHECK_GITHUB_CLIENT_ID=
SCAMCHECK_GITHUB_CLIENT_SECRET=
